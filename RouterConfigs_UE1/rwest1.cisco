# 1)Prep
ena
conf t
hostname RWest1
no ip domain lookup
int eth0/0
ip ad 172.31.255.250 255.255.255.252
ipv6 ad fe80::1 link-local
int eth0/1
ip ad 172.31.255.237 255.255.255.252
ipv6 ad fe80::2:1 link-local
int eth0/2
ip ad 172.31.255.233 255.255.255.252
ipv6 ad fe80::2:1 link-local
ex
int range eth0/0-2
no shut

end

cop ru st

# 2)RIPv2
ena
conf t
router rip
version 2
no auto-summary
network 172.31.255.248
network 172.31.255.236
network 172.31.255.232

end

cop ru st

# 3) RIPng
ena
conf t

ipv6 unicast-routing
ipv6 router rip process1
int range e0/0-2
ipv6 rip process1 enable

end

cop ru st


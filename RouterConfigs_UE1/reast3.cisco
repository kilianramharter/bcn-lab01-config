# 1)Prep
ena
conf t
hostname REast3
no ip domain lookup
ipv6 unicast-routing
int eth0/0
ip ad 172.17.255.254 255.255.0.0
ipv6 ad fe80::1:3 link-local
ipv6 ad 2001:DB8:ACAD:AC17::254/64
int eth0/1
ip ad 172.31.255.242 255.255.255.252
ipv6 ad fe80::1:3 link-local
int eth0/2
ip ad 172.31.255.230 255.255.255.252
ipv6 ad fe80::1:3 link-local
ex
int range eth0/0-2
no shut


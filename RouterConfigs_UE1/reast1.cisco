# 1)Prep
ena
conf t
hostname REast1
no ip domain lookup
int eth0/0
ip ad 172.31.255.254 255.255.255.252
ipv6 ad fe80::1 link-local
int eth0/1
ip ad 172.31.255.245 255.255.255.252
ipv6 ad fe80::1:1 link-local
int eth0/2
ip ad 172.31.255.241 255.255.255.252
ipv6 ad fe80::1:1 link-local
ex
int range eth0/0-2
no shut
exi
exi
exi
cop ru st

disa

# 2)RIPv2
ena
conf t
router rip
version 2
no auto-summary
network 172.31.255.252
network 172.31.255.244
network 172.31.255.240


exi
exi

cop ru st

# 3) RIPng
ena
conf t

ipv6 unicast-routing
ipv6 router rip process1
int range e0/1-2

exi
exi

cop ru st


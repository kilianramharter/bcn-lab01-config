# 1)Prep
ena
conf t
hostname RWest3
no ip domain lookup
int eth0/0
ip ad 172.19.255.254 255.255.0.0
ipv6 ad fe80::2:3 link-local
ipv6 ad 2001:DB8:ACAD:AC19::254/64
int eth0/1
ip ad 172.31.255.234 255.255.255.252
ipv6 ad fe80::2:3 link-local
ex
int range eth0/0-1
no shut

end

cop ru st

# 2)RIPv2
ena
conf t
router rip
version 2
no auto-summary
network 172.19.0.0
network 172.31.255.232

end

cop ru st

# 3) RIPng
ena
conf t

ipv6 unicast-routing
ipv6 router rip process1
int range e0/0-1
ipv6 rip process1 enable

end

cop ru st

